# Plantilla de variables de entorno para Transitly. Copia este archivo
# como .env y rellena con valores reales. .env está gitignored — no
# commitear nunca claves reales.
#
# Solo se cargan en el cliente las claves "publishable" / anon. La
# service_role de Supabase se usa exclusivamente desde Edge Functions
# y scripts CLI; nunca debe entrar al bundle del cliente.

# ── Supabase (F2) ──────────────────────────────────────────────
# URL del proyecto (formato https://<ref>.supabase.co).
SUPABASE_URL=
# Clave anon (JWT) o publishable (sb_publishable_*). Cliente final.
SUPABASE_ANON_KEY=
# URL del runtime de Edge Functions, normalmente <SUPABASE_URL>/functions/v1.
SUPABASE_FUNCTIONS_URL=

# ── Analítica + telemetría (F22) ───────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com
SENTRY_DSN=

# ── Mapas (F20) ────────────────────────────────────────────────
# Clave API de MapTiler. Opcional: si no se define, el mapa usa
# CartoDB como fallback gratuito (misma cobertura, sin API key).
MAPTILER_API_KEY=
