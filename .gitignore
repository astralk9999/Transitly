# Secrets — nunca commitear .env (Supabase, PostHog, Sentry, MapTiler).
# Replícalo desde .env.example para configurar tu entorno local.
.env
.env.local
.env.*.local

# Defines pasados al build (--dart-define-from-file). Contiene anon key
# de Supabase. Replicar desde .env para builds locales.
dart_defines.json

# APKs nunca al repo: GitHub avisa >50MB, bloquea >100MB, e infla el
# historial git. Distribuir SIEMPRE como GitHub Release assets:
# https://github.com/astralk9999/Transitly/releases
*.apk

# Supabase CLI — caché local, access token y referencia al proyecto
# vinculado. Generado por `supabase login` y `supabase link`.
.supabase/
supabase/.temp/

# Claude Code MCP — config local con PAT de Supabase (Personal Access
# Token). Plantilla en .mcp.json.example. NUNCA commitear.
.mcp.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Hive temp dir created by tests (see test/helpers Hive setup)
/test/hive_temp/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
tools/ocr/out/
