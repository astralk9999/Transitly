---
// Texto en marquesina sobre una curva (SVG), versión vanilla del CurvedLoop.
// Se desliza solo. Sin interacción de arrastre (no necesaria en una landing).
interface Props {
  text?: string;
  speed?: number; // px por frame
  curveAmount?: number;
  class?: string;
}
const {
  text = 'Transitly ✦ Jerez ✦ COMUJESA ✦ ',
  speed = 1,
  curveAmount = 280,
  class: className = '',
} = Astro.props;
const pathD = `M-100,40 Q720,${40 + curveAmount} 1540,40`;
const repeated = (text + ' ').repeat(8);
---
<div class:list={['curved-loop', className]} data-speed={speed}>
  <svg viewBox="0 0 1440 220" preserveAspectRatio="xMidYMid meet">
    <defs>
      <path id="curved-loop-path" d={pathD} fill="none" />
    </defs>
    <text class="curved-loop-text">
      <textPath href="#curved-loop-path" startOffset="0">{repeated}</textPath>
    </text>
  </svg>
</div>

<style>
  .curved-loop { width: 100%; overflow: hidden; user-select: none; }
  .curved-loop svg { width: 100%; display: block; overflow: visible; }
  .curved-loop-text {
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 800;
    font-size: 42px;
    letter-spacing: 2px;
    text-transform: uppercase;
    fill: url(#cl-grad);
  }
</style>

<svg width="0" height="0" style="position:absolute">
  <defs>
    <linearGradient id="cl-grad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#00D4FF" />
      <stop offset="50%" stop-color="#977DDF" />
      <stop offset="100%" stop-color="#FF006E" />
    </linearGradient>
  </defs>
</svg>

<script>
  function initCurvedLoop(el: HTMLElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const tp = el.querySelector('textPath');
    if (!tp) return;
    const speed = parseFloat(el.dataset.speed || '1');
    let offset = 0;
    let raf = 0;
    const total = (tp as unknown as SVGTextContentElement).getComputedTextLength() / 8 || 600;
    const step = () => {
      offset -= speed;
      if (offset <= -total) offset += total;
      tp.setAttribute('startOffset', offset + 'px');
      raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else raf = requestAnimationFrame(step);
    });
  }
  document.querySelectorAll<HTMLElement>('.curved-loop').forEach(initCurvedLoop);
</script>
