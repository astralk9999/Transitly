---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const fullTitle = `${title} · Transitly`;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description || fullTitle} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description || fullTitle} />
  <meta property="og:site_name" content="Transitly" />
  {ogImage && <meta property="og:image" content={ogImage} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description || fullTitle} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <title>{fullTitle}</title>
</head>
<body class="bg-transit-bg text-text-hi font-sans antialiased min-h-screen flex flex-col">
  <header class="border-b border-transit-border bg-transit-bg/90 backdrop-blur-md sticky top-0 z-50">
    <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <span class="text-xl font-bold bg-gradient-accent bg-clip-text text-transparent tracking-tight">
          Transitly
        </span>
      </a>
      <div class="flex items-center gap-6 text-text-mid text-sm">
        <a href="/ciudades" class="hover:text-text-hi transition-colors">Ciudades</a>
        <a href="/sobre" class="hover:text-text-hi transition-colors">Acerca de</a>
        <a href="/app/" class="px-4 py-1.5 rounded-full border border-transit-accent text-transit-accent hover:bg-transit-accent-bg transition-colors text-xs font-medium">
          Abrir app
        </a>
      </div>
    </nav>
  </header>

  <main class="flex-1">
    <slot />
  </main>

  <footer class="border-t border-transit-border bg-transit-bg py-12">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <span class="text-lg font-bold bg-gradient-accent bg-clip-text text-transparent">Transitly</span>
          <p class="text-text-lo text-sm mt-2 max-w-xs">
            Tu transporte público, simple. Rutas, horarios y paradas de autobús en España.
          </p>
        </div>
        <div>
          <h4 class="text-text-mid text-xs font-semibold uppercase tracking-widest mb-3">Explora</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/ciudades" class="text-text-lo hover:text-text-hi transition-colors">Ciudades</a></li>
            <li><a href="/app/" class="text-text-lo hover:text-text-hi transition-colors">Abrir app</a></li>
            <li><a href="/sobre" class="text-text-lo hover:text-text-hi transition-colors">Funcionalidades</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-text-mid text-xs font-semibold uppercase tracking-widest mb-3">Legal</h4>
          <ul class="space-y-2 text-sm">
            <li><a href="/privacidad" class="text-text-lo hover:text-text-hi transition-colors">Privacidad</a></li>
            <li><a href="/terminos" class="text-text-lo hover:text-text-hi transition-colors">Términos</a></li>
            <li><a href="/sobre" class="text-text-lo hover:text-text-hi transition-colors">Acerca de</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-transit-divider mt-8 pt-6 text-center text-text-disabled text-xs">
        &copy; {new Date().getFullYear()} Transitly. Todos los derechos reservados.
      </div>
    </div>
  </footer>
</body>
</html>
