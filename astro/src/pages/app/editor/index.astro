---
import Layout from '../../../layouts/Layout.astro';
const FLUTTER_BUILD_PATH = '/flutter-web-build';
---
<Layout title="Editor de rutas" description="Crea y edita rutas de transporte público con el editor visual de Transitly.">
  <section class="min-h-[calc(100vh-12rem)] flex flex-col">
    <div class="bg-transit-surface border-b border-transit-border px-6 py-4">
      <a href="/" class="text-text-lo text-sm hover:text-text-hi transition-colors">← Volver a Transitly</a>
    </div>
    <div id="flutter-editor" class="flex-1 flex items-center justify-center">
      <div class="text-center text-text-lo">
        <p>El editor interactivo requiere Flutter Web.</p>
        <p class="text-sm mt-2">Compila la app con:</p>
        <code class="inline-block mt-2 px-3 py-1.5 rounded-lg bg-transit-input text-xs font-mono text-transit-neon-cyan">
          flutter build web --release --base-href "/app/editor/" --pwa-strategy none
        </code>
      </div>
    </div>
  </section>
</Layout>

