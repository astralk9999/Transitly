---
import Layout from '../layouts/Layout.astro';
import ColorBends from '../components/ColorBends.astro';
import Counter from '../components/Counter.astro';
import CurvedLoop from '../components/CurvedLoop.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// Cifras de respaldo (datos reales del despliegue de COMUJESA en Jerez).
// Se usan para la presentación cuando el fetch a Supabase no está disponible
// o devuelve 0 (p. ej. sin variables PUBLIC_SUPABASE_* en el entorno).
let operatorsCount = 1;
let routesCount = 20;
let stopsCount = 306;

if (supabaseUrl && supabaseKey) {
  try {
    const headers: Record<string, string> = {
      apikey: supabaseKey,
      Authorization: `Bearer ${supabaseKey}`,
      Prefer: 'count=exact',
    };
    const [opRes, rtRes, stRes] = await Promise.all([
      fetch(`${supabaseUrl}/rest/v1/operators?select=count`, { headers }),
      fetch(`${supabaseUrl}/rest/v1/routes?select=count`, { headers }),
      fetch(`${supabaseUrl}/rest/v1/stops?select=count`, { headers }),
    ]);
    if (opRes.ok) { const n = (await opRes.json())[0]?.count; if (n) operatorsCount = n; }
    if (rtRes.ok) { const n = (await rtRes.json())[0]?.count; if (n) routesCount = n; }
    if (stRes.ok) { const n = (await stRes.json())[0]?.count; if (n) stopsCount = n; }
  } catch {
    // Mantiene las cifras de respaldo
  }
}

const appVersion = 'v0.1.0';

const icons: Record<string, string> = {
  clock: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  users: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  star: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
  'wifi-off': '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l22 22"/><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55M5 12.55a10.94 10.94 0 0 1 5.17-2.39M10.71 5.05A16 16 0 0 1 22.58 9M1.42 9a15.91 15.91 0 0 1 4.7-2.88M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/></svg>',
  bell: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>',
  map: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>',
  user: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
  bus: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v11"/><path d="M4 11h16"/><circle cx="7.5" cy="17.5" r="1.5"/><circle cx="16.5" cy="17.5" r="1.5"/></svg>',
  building: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4M9 6h.01M15 6h.01M9 10h.01M15 10h.01M9 14h.01M15 14h.01"/></svg>',
  android: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 9.48l1.84-3.18a.4.4 0 0 0-.69-.4l-1.86 3.22a11.5 11.5 0 0 0-9.78 0L5.25 5.9a.4.4 0 1 0-.69.4L6.4 9.48A10.8 10.8 0 0 0 1 18h22a10.8 10.8 0 0 0-5.4-8.52zM7 15.25a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5zm10 0a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5z"/></svg>',
  download: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>',
};

const features = [
  { title: 'Horarios exactos por parada', body: 'La hora real de paso de cada línea en cada parada, de los horarios oficiales de COMUJESA. Entre semana, sábado y domingo, con la próxima llegada resaltada.', icon: 'clock' },
  { title: 'Rutas de la comunidad', body: '¿Falta una línea? Créala sobre el mapa con sus paradas y horarios, compártela y deja que otros la voten y la descarguen a su mapa.', icon: 'users' },
  { title: 'Favoritos y paradas cercanas', body: 'Guarda tus líneas y paradas favoritas —oficiales o de la comunidad— y tenlas en tu inicio, junto a las paradas más cercanas a ti.', icon: 'star' },
  { title: 'Funciona sin conexión', body: 'Descarga las líneas y sus horarios para consultarlos sin datos. La app sincroniza sola cuando vuelves a tener internet.', icon: 'wifi-off' },
  { title: 'Avisos en tu zona', body: 'Recibe avisos geolocalizados (cortes, desvíos, incidencias) cuando afectan a tu zona, y reporta lo que veas para ayudar a los demás.', icon: 'bell' },
  { title: 'Mapa en vivo', body: 'Explora todas las líneas y paradas sobre un mapa interactivo. Toca una parada y mira qué pasa por ella y a qué hora.', icon: 'map' },
];

const audiences = [
  { title: 'Viajeros', body: 'Consulta horarios, guarda favoritas, mira las paradas cercanas y planifica tu trayecto. Online y sin conexión.', icon: 'user' },
  { title: 'Conductores', body: 'Modo conductor con seguimiento en vivo del trayecto, activable con un código de invitación de tu operadora.', icon: 'bus' },
  { title: 'Operadoras', body: 'Panel propio para gestionar líneas, paradas, horarios, zonas y el equipo de conductores de tu empresa.', icon: 'building' },
];

const steps = [
  { n: '01', title: 'Abre Transitly', body: 'En el navegador o instala la app para Android. Sin registro para consultar.' },
  { n: '02', title: 'Encuentra tu línea', body: 'Busca por nombre, explora el mapa o mira las paradas más cercanas a ti.' },
  { n: '03', title: 'Viaja informado', body: 'Guarda favoritas, mira la próxima llegada exacta y recibe avisos de tu zona.' },
];

const faqs = [
  { q: '¿Necesito registrarme para usarla?', a: 'No. Puedes consultar líneas, horarios y el mapa como invitado. La cuenta solo hace falta para guardar favoritas, crear rutas de comunidad o el modo conductor.' },
  { q: '¿Es gratis?', a: 'Sí, Transitly es gratuita. Es un proyecto abierto centrado en mejorar la información del transporte público.' },
  { q: '¿De dónde salen los horarios?', a: 'De los horarios oficiales de COMUJESA, procesados para mostrarte la hora exacta de paso en cada parada (entre semana, sábado y domingo).' },
  { q: '¿Funciona sin internet?', a: 'Sí. Puedes descargar las líneas y sus horarios para consultarlos sin datos; la app sincroniza sola al recuperar conexión.' },
  { q: '¿Qué son las rutas de la comunidad?', a: 'Cualquiera puede crear una línea sobre el mapa con sus paradas y horarios, compartirla y permitir que otros la voten e importen a su mapa.' },
  { q: '¿Hay app para iPhone?', a: 'La web funciona en cualquier móvil. La app nativa está disponible para Android (APK); la versión de iOS llegará más adelante.' },
];
---

<Layout
  title="Tu transporte público, simple"
  description="Líneas, horarios exactos por parada y rutas de la comunidad en Jerez. Consulta los autobuses de COMUJESA, crea y comparte rutas, guarda tus favoritas y viaja informado con Transitly."
>
  <!-- ── FONDO SHADER ColorBends (paleta por defecto de la app: tonos del
       accent morado #977DDF, igual que el fondo ColorBends de la app) ── -->
  <ColorBends colors={["#C9B8F0", "#977DDF", "#5B4A9E"]} />
  <!-- Velo de contraste: vignette + degradado para legibilidad sobre el
       fondo animado. Se adapta al tema (oscuro/claro) — antes era oscuro
       fijo y en modo claro ensuciaba toda la página. -->
  <div class="page-veil fixed inset-0 -z-[9] pointer-events-none"></div>

  <!-- ── HERO ── -->
  <section class="relative">
    <div class="max-w-6xl mx-auto px-6 pt-20 pb-16 md:pt-28 md:pb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <!-- Columna izquierda: copy -->
        <div class="text-center lg:text-left">
          <div class="hero-in inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-transit-accent/30 bg-transit-surface/60 backdrop-blur-sm text-text-mid text-xs font-medium mb-6" style="animation-delay:.05s">
            <span class="w-1.5 h-1.5 rounded-full bg-transit-state-ontime glow-pulse"></span>
            Jerez de la Frontera · COMUJESA
          </div>

          <h1 class="hero-in text-4xl md:text-6xl font-bold tracking-tight leading-[1.05]" style="animation-delay:.12s">
            Tu transporte público,<br />
            <span class="gradient-animated bg-gradient-to-r from-transit-neon-cyan via-transit-accent to-transit-neon-magenta bg-clip-text text-transparent">
              simple y al día.
            </span>
          </h1>
          <p class="hero-in text-text-mid text-lg md:text-xl mt-6 max-w-xl mx-auto lg:mx-0 leading-relaxed" style="animation-delay:.2s">
            Horarios exactos por parada de los autobuses de Jerez, rutas creadas
            por la comunidad y tus líneas favoritas siempre a mano. Online y sin
            conexión.
          </p>

          <div class="hero-in flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mt-9" style="animation-delay:.28s">
            <a href="/app/" class="px-8 py-3.5 rounded-full bg-gradient-accent text-white font-semibold text-sm hover:opacity-90 hover:-translate-y-0.5 transition-all shadow-lg shadow-transit-accent/40">
              Abrir Transitly
            </a>
            <a href="#descargar" class="px-8 py-3.5 rounded-full border border-transit-border bg-transit-surface/40 backdrop-blur-sm text-text-hi font-semibold text-sm hover:border-transit-accent hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
              <span set:html={icons.android} /> Descargar APK
            </a>
          </div>

          <div class="hero-in grid grid-cols-3 gap-6 mt-12 max-w-md mx-auto lg:mx-0" style="animation-delay:.36s">
            <div>
              <Counter value={operatorsCount} class="text-3xl md:text-4xl font-bold font-mono text-transit-neon-cyan" />
              <div class="text-text-lo text-xs mt-1 uppercase tracking-wider">Operadores</div>
            </div>
            <div>
              <Counter value={routesCount} class="text-3xl md:text-4xl font-bold font-mono text-transit-neon-magenta" />
              <div class="text-text-lo text-xs mt-1 uppercase tracking-wider">Líneas</div>
            </div>
            <div>
              <Counter value={stopsCount} class="text-3xl md:text-4xl font-bold font-mono text-transit-neon-purple" />
              <div class="text-text-lo text-xs mt-1 uppercase tracking-wider">Paradas</div>
            </div>
          </div>
        </div>

        <!-- Columna derecha: logo de la app con anillos orbitales animados -->
        <div class="hero-in flex justify-center lg:justify-end" style="animation-delay:.2s">
          <div class="hero-logo">
            <!-- resplandor pulsante -->
            <div class="hero-logo-glow"></div>
            <!-- anillos que orbitan -->
            <div class="hero-ring hero-ring-1"></div>
            <div class="hero-ring hero-ring-2"></div>
            <!-- puntos orbitando -->
            <div class="hero-orbit hero-orbit-1"><span class="hero-dot"></span></div>
            <div class="hero-orbit hero-orbit-2"><span class="hero-dot hero-dot-cyan"></span></div>
            <img src="/branding/logo.png" alt="Transitly" width="320" height="320"
              class="hero-logo-img float-y" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FEATURES ── -->
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-24">
    <div class="reveal text-center mb-14">
      <span class="text-transit-accent text-xs font-mono font-semibold uppercase tracking-[0.2em]">Funcionalidades</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-3">Todo lo que necesitas para moverte</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f, i) => (
        <div class="reveal spot feature-card group p-7 rounded-2xl bg-transit-surface/70 backdrop-blur-sm border border-transit-border hover:border-transit-accent/50 hover:bg-transit-raised/70 hover:-translate-y-1 transition-all duration-300" style={`transition-delay:${i * 60}ms`}>
          <div class="w-12 h-12 rounded-xl bg-transit-accent-bg flex items-center justify-center mb-5 text-transit-accent group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-transit-accent/30 transition-all" set:html={icons[f.icon]} />
          <h3 class="text-lg font-semibold mb-2">{f.title}</h3>
          <p class="text-text-lo text-sm leading-relaxed">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── PARA QUIÉN ── -->
  <section class="relative border-y border-transit-border bg-transit-surface/30 backdrop-blur-sm">
    <div class="max-w-6xl mx-auto px-6 py-20 md:py-24">
      <div class="reveal text-center mb-14">
        <span class="text-transit-accent text-xs font-mono font-semibold uppercase tracking-[0.2em]">Para cada tipo de usuario</span>
        <h2 class="text-3xl md:text-4xl font-bold mt-3">Una plataforma, muchos roles</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {audiences.map((a, i) => (
          <div class="reveal p-8 rounded-2xl bg-transit-bg/60 border border-transit-border hover:border-transit-accent/40 transition-all" style={`transition-delay:${i * 80}ms`}>
            <div class="w-14 h-14 rounded-full bg-transit-accent-bg border border-transit-accent/30 flex items-center justify-center mb-5 text-transit-accent" set:html={icons[a.icon]} />
            <h3 class="text-lg font-semibold mb-2">{a.title}</h3>
            <p class="text-text-lo text-sm leading-relaxed">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SEPARADOR: texto curvo en marquesina ── -->
  <div class="py-6 md:py-10 opacity-90">
    <CurvedLoop text="Horarios exactos ✦ Rutas de la comunidad ✦ Sin conexión ✦ Avisos en tu zona ✦ " speed={0.8} curveAmount={120} />
  </div>

  <!-- ── DESCARGA APK ── -->
  <section id="descargar" class="max-w-5xl mx-auto px-6 py-16 md:py-20">
    <div class="reveal relative p-8 md:p-12 rounded-3xl bg-gradient-to-br from-transit-raised/80 to-transit-surface/60 backdrop-blur border border-transit-accent/20 overflow-hidden">
      <div class="absolute -top-24 -right-16 w-72 h-72 rounded-full bg-transit-accent/15 blur-3xl pointer-events-none"></div>
      <div class="relative flex flex-col md:flex-row items-center gap-8">
        <div class="shrink-0 float-y">
          <div class="w-24 h-24 rounded-3xl bg-transit-bg/60 border border-transit-accent/30 flex items-center justify-center shadow-xl shadow-transit-accent/20">
            <img src="/branding/logo.png" alt="" width="64" height="64" class="w-16 h-16" />
          </div>
        </div>
        <div class="flex-1 text-center md:text-left">
          <span class="text-transit-accent text-xs font-mono font-semibold uppercase tracking-[0.2em]">Descarga la app</span>
          <h2 class="text-2xl md:text-3xl font-bold mt-2">Transitly para Android</h2>
          <p class="text-text-mid text-sm mt-3 max-w-lg">
            Instala la última versión en tu móvil. Widgets, modo conductor, notificaciones
            y uso sin conexión. (Fuera de Google Play: permite "instalar apps de orígenes desconocidos").
          </p>
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 mt-6">
            <a href="/downloads/transitly-latest.apk" download
              class="px-7 py-3.5 rounded-full bg-gradient-accent text-white font-semibold text-sm hover:opacity-90 hover:-translate-y-0.5 transition-all shadow-lg shadow-transit-accent/40 flex items-center gap-2">
              <span set:html={icons.download} /> Descargar APK
            </a>
            <div class="flex items-center gap-3 text-text-lo text-xs font-mono">
              <span class="flex items-center gap-1.5"><span class="text-transit-accent" set:html={icons.android} /> {appVersion}</span>
              <span>·</span>
              <span>Android 6+</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── RECORRIDO: mini-vistas de la app ── -->
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-24">
    <div class="reveal text-center mb-14">
      <span class="text-transit-accent text-xs font-mono font-semibold uppercase tracking-[0.2em]">Un vistazo</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-3">Así se ve por dentro</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Vista: Mapa -->
      <div class="reveal rounded-2xl bg-transit-surface/70 backdrop-blur-sm border border-transit-border overflow-hidden">
        <div class="screen-map h-44 relative">
          <span class="screen-bus">L1</span>
        </div>
        <div class="p-5">
          <h3 class="font-semibold">Mapa en vivo</h3>
          <p class="text-text-lo text-sm mt-1 leading-relaxed">Líneas y paradas sobre el mapa, con los buses moviéndose en tiempo real.</p>
        </div>
      </div>
      <!-- Vista: Parada -->
      <div class="reveal rounded-2xl bg-transit-surface/70 backdrop-blur-sm border border-transit-border overflow-hidden" style="transition-delay:80ms">
        <div class="h-44 p-4 flex flex-col gap-2 bg-transit-bg/40">
          <div class="text-xs text-text-lo uppercase tracking-wider">Plaza del Arenal</div>
          {['L1 · 08:42', 'L2 · 08:47', 'L8 · 08:51'].map((t) => (
            <div class="flex items-center gap-3 rounded-lg bg-transit-raised/60 px-3 py-2">
              <span class="w-9 h-6 rounded grid place-items-center text-[11px] font-bold font-mono text-white" style="background:#977DDF">{t.split(' · ')[0]}</span>
              <span class="text-text-mid text-sm flex-1">Hospital</span>
              <span class="font-mono text-transit-accent text-sm">{t.split(' · ')[1]}</span>
            </div>
          ))}
        </div>
        <div class="p-5">
          <h3 class="font-semibold">Horario por parada</h3>
          <p class="text-text-lo text-sm mt-1 leading-relaxed">La hora exacta de cada línea que pasa, con la próxima llegada resaltada.</p>
        </div>
      </div>
      <!-- Vista: Comunidad -->
      <div class="reveal rounded-2xl bg-transit-surface/70 backdrop-blur-sm border border-transit-border overflow-hidden" style="transition-delay:160ms">
        <div class="h-44 p-4 flex flex-col gap-2 bg-transit-bg/40">
          {[['#00D4FF','C1','Ruta Norte'],['#FF006E','C2','Polígono'],['#22C55E','C3','Universidad']].map((r) => (
            <div class="flex items-center gap-3 rounded-lg bg-transit-raised/60 px-3 py-2">
              <span class="w-9 h-6 rounded grid place-items-center text-[11px] font-bold font-mono text-white" style={`background:${r[0]}`}>{r[1]}</span>
              <span class="text-text-mid text-sm flex-1">{r[2]}</span>
              <span class="text-[10px] text-transit-state-ontime font-bold">COMUNIDAD</span>
            </div>
          ))}
        </div>
        <div class="p-5">
          <h3 class="font-semibold">Rutas de la comunidad</h3>
          <p class="text-text-lo text-sm mt-1 leading-relaxed">Líneas creadas por usuarios que puedes votar e importar a tu mapa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CÓMO EMPEZAR ── -->
  <section class="max-w-5xl mx-auto px-6 pb-20 md:pb-24">
    <div class="reveal text-center mb-14">
      <span class="text-transit-accent text-xs font-mono font-semibold uppercase tracking-[0.2em]">Cómo empezar</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-3">En tres pasos</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {steps.map((s, i) => (
        <div class="reveal" style={`transition-delay:${i * 80}ms`}>
          <div class="text-6xl font-bold font-mono bg-gradient-accent bg-clip-text text-transparent opacity-30">{s.n}</div>
          <h3 class="text-lg font-semibold mt-2 mb-2">{s.title}</h3>
          <p class="text-text-lo text-sm leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="max-w-3xl mx-auto px-6 py-20 md:py-24">
    <div class="reveal text-center mb-12">
      <span class="text-transit-accent text-xs font-mono font-semibold uppercase tracking-[0.2em]">Preguntas frecuentes</span>
      <h2 class="text-3xl md:text-4xl font-bold mt-3">¿Tienes dudas?</h2>
    </div>
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="reveal group rounded-2xl bg-transit-surface/70 backdrop-blur-sm border border-transit-border hover:border-transit-accent/40 transition-colors">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none">
            <span class="font-semibold text-text-hi">{f.q}</span>
            <span class="text-transit-accent shrink-0 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
          </summary>
          <p class="px-5 pb-5 -mt-1 text-text-lo text-sm leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── CTA FINAL ── -->
  <section class="max-w-6xl mx-auto px-6 pb-28">
    <div class="reveal p-10 md:p-16 rounded-3xl bg-gradient-to-br from-transit-surface to-transit-raised border border-transit-border relative overflow-hidden text-center">
      <div class="absolute inset-0 bg-gradient-to-r from-transit-neon-cyan/8 via-transparent to-transit-neon-purple/8 pointer-events-none"></div>
      <div class="aurora-blob absolute -bottom-20 left-1/2 -translate-x-1/2 w-80 h-80 rounded-full bg-transit-accent/15 blur-3xl pointer-events-none"></div>
      <img src="/branding/logo.png" alt="" width="72" height="72" class="mx-auto mb-6 w-18 h-18 relative z-10 float-y" />
      <h2 class="text-2xl md:text-3xl font-bold relative z-10">¿Listo para empezar?</h2>
      <p class="text-text-mid mt-4 max-w-md mx-auto relative z-10">
        Abre Transitly en tu navegador, sin instalar nada, o descarga la app para Android.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8 relative z-10">
        <a href="/app/" class="px-8 py-3.5 rounded-full bg-white text-transit-bg font-semibold text-sm hover:opacity-90 hover:-translate-y-0.5 transition-all">
          Abrir en el navegador
        </a>
        <a href="#descargar" class="px-8 py-3.5 rounded-full border border-transit-border text-text-mid font-semibold text-sm hover:border-transit-accent hover:text-text-hi transition-all">
          Descargar APK
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Entrada del hero al cargar (no espera al scroll). */
  .hero-in {
    opacity: 0;
    transform: translateY(22px);
    animation: hero-in-anim 0.7s cubic-bezier(0.22,1,0.36,1) forwards;
  }
  @keyframes hero-in-anim { to { opacity: 1; transform: none; } }

  /* Spotlight que sigue al cursor en las tarjetas de features. */
  .spot {
    position: relative;
    overflow: hidden;
  }
  .spot::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      360px circle at var(--mx, 50%) var(--my, 0%),
      rgba(151,125,223,0.22), transparent 45%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .spot:hover::before { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .hero-in { opacity: 1; transform: none; animation: none; }
  }

  /* Logo del hero con anillos orbitales (estética animada de la app). */
  .hero-logo {
    position: relative;
    width: 18rem; height: 18rem;
    display: flex; align-items: center; justify-content: center;
  }
  @media (max-width: 768px) { .hero-logo { width: 15rem; height: 15rem; } }

  .hero-logo-glow {
    position: absolute; inset: -10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(151,125,223,0.35), transparent 65%);
    animation: hl-glow 4s ease-in-out infinite;
  }
  .hero-logo-img {
    position: relative; z-index: 2;
    width: 64%; height: 64%;
    filter: drop-shadow(0 0 50px rgba(151,125,223,0.55));
  }
  .hero-ring {
    position: absolute; border-radius: 50%;
    border: 1px solid rgba(151,125,223,0.35);
  }
  .hero-ring-1 { inset: 4%; animation: hl-spin 18s linear infinite; border-style: dashed; }
  .hero-ring-2 { inset: 16%; border-color: rgba(201,184,240,0.25); animation: hl-spin 26s linear infinite reverse; }

  /* Puntos que orbitan sobre cada anillo */
  .hero-orbit {
    position: absolute; inset: 0;
    animation: hl-spin 12s linear infinite;
  }
  .hero-orbit-2 { animation-duration: 9s; animation-direction: reverse; }
  .hero-dot {
    position: absolute; top: 4%; left: 50%;
    width: 12px; height: 12px; margin-left: -6px;
    border-radius: 50%; background: #977DDF;
    box-shadow: 0 0 14px 3px rgba(151,125,223,0.8);
  }
  .hero-dot-cyan {
    top: auto; bottom: 14%;
    background: #C9B8F0; box-shadow: 0 0 14px 3px rgba(201,184,240,0.8);
  }

  @keyframes hl-spin { to { transform: rotate(360deg); } }
  @keyframes hl-glow {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50% { opacity: 0.95; transform: scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-logo-glow, .hero-ring, .hero-orbit { animation: none; }
  }

  /* Mini-vista "mapa" de la sección de recorrido. */
  .screen-map {
    background:
      radial-gradient(circle at 30% 30%, rgba(151,125,223,0.25), transparent 60%),
      #0C0C20;
    background-image:
      linear-gradient(rgba(151,125,223,0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(151,125,223,0.08) 1px, transparent 1px);
    background-size: 100% 100%, 26px 26px, 26px 26px;
    position: relative;
  }
  .screen-map::before, .screen-map::after {
    content: ''; position: absolute; left: -10%; right: -10%; height: 3px;
    border-radius: 3px;
  }
  .screen-map::before { top: 38%; background: #00D4FF; transform: rotate(-8deg); opacity: 0.85; }
  .screen-map::after  { top: 62%; background: #977DDF; transform: rotate(6deg); opacity: 0.85; }
  .screen-bus {
    position: absolute; top: 32%; left: 46%;
    background: #00D4FF; color: #04121a; font-weight: 800; font-size: 11px;
    font-family: 'IBM Plex Mono', monospace;
    padding: 3px 7px; border-radius: 7px; border: 2px solid #fff;
    box-shadow: 0 3px 8px rgba(0,0,0,0.4);
    animation: float-y 5s ease-in-out infinite;
    z-index: 2;
  }
</style>

<script is:inline>
  // Spotlight que sigue al cursor en las tarjetas de features.
  (function () {
    document.querySelectorAll('.feature-card').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });
  })();
</script>
