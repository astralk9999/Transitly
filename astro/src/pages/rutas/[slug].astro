---
import Layout from '../../layouts/Layout.astro';

export interface Props {
  slug: string;
}

const { slug } = Astro.params;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

interface RouteDetail {
  id: string;
  name: string;
  code: string;
  color: string;
  description?: string;
  operator_name?: string;
  operator_slug?: string;
  source: string;
  status: string;
}

interface StopInfo {
  id: string;
  name: string;
  sequence: number;
  direction?: string;
  lat?: number;
  lng?: number;
}

interface ScheduleInfo {
  id: string;
  stop_id: string;
  departure_time: string;
  days: string;
}

let route: RouteDetail | null = null;
let stops: StopInfo[] = [];
let schedules: ScheduleInfo[] = [];
let mapUrl: string | null = null;

if (supabaseUrl && supabaseKey) {
  try {
    const headers: Record<string, string> = {
      apikey: supabaseKey,
      Authorization: `Bearer ${supabaseKey}`,
    };

    const linkRes = await fetch(
      `${supabaseUrl}/rest/v1/route_public_links?select=route_id&slug=eq.${encodeURIComponent(slug)}`,
      { headers }
    );

    let routeId: string | null = null;

    if (linkRes.ok) {
      const linkData = await linkRes.json();
      if (linkData.length > 0) {
        routeId = linkData[0].route_id;
      }
    }

    if (!routeId) {
      const rtRes = await fetch(
        `${supabaseUrl}/rest/v1/routes?select=id,name,code,color,description,source,status,operator:operators(name,slug)&public_link_slug=eq.${encodeURIComponent(slug)}`,
        { headers }
      );
      if (rtRes.ok) {
        const rtData = await rtRes.json();
        if (rtData.length > 0) {
          routeId = rtData[0].id;
          route = {
            id: rtData[0].id,
            name: rtData[0].name,
            code: rtData[0].code,
            color: rtData[0].color,
            description: rtData[0].description,
            operator_name: rtData[0].operator?.name,
            operator_slug: rtData[0].operator?.slug,
            source: rtData[0].source,
            status: rtData[0].status,
          };
        }
      }
    } else if (!route) {
      const rtRes = await fetch(
        `${supabaseUrl}/rest/v1/routes?select=id,name,code,color,description,source,status,operator:operators(name,slug)&id=eq.${routeId}`,
        { headers }
      );
      if (rtRes.ok) {
        const rtData = await rtRes.json();
        if (rtData.length > 0) {
          route = {
            id: rtData[0].id,
            name: rtData[0].name,
            code: rtData[0].code,
            color: rtData[0].color,
            description: rtData[0].description,
            operator_name: rtData[0].operator?.name,
            operator_slug: rtData[0].operator?.slug,
            source: rtData[0].source,
            status: rtData[0].status,
          };
        }
      }
    }

    if (route) {
      const [stopsRes, schedRes] = await Promise.all([
        fetch(
          `${supabaseUrl}/rest/v1/route_stops?select=id,name,sequence,direction,lat,lng&route_id=eq.${route.id}&order=sequence.asc`,
          { headers }
        ),
        fetch(
          `${supabaseUrl}/rest/v1/schedules?select=id,stop_id,departure_time,days&route_id=eq.${route.id}&order=departure_time.asc`,
          { headers }
        ),
      ]);

      if (stopsRes.ok) stops = await stopsRes.json();
      if (schedRes.ok) schedules = await schedRes.json();

      if (stops.length > 0) {
        const avgLat = stops.reduce((s, st) => s + (st.lat || 0), 0) / stops.length;
        const avgLng = stops.reduce((s, st) => s + (st.lng || 0), 0) / stops.length;
        mapUrl = `https://api.maptiler.com/maps/streets-v2/static/${avgLng},${avgLat},13/600x400.png?key=${import.meta.env.PUBLIC_MAPTILER_API_KEY || ''}`;
      }
    }
  } catch {
    // Data unavailable
  }
}

const title = route ? `Línea ${route.code} — ${route.name} · Transitly` : 'Ruta no encontrada · Transitly';
const description = route?.description || `Horarios y paradas de la línea ${route?.code || ''}.`;
---

<Layout title={title} description={description} ogImage={mapUrl || undefined}>
  {!route ? (
    <section class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h1 class="text-3xl font-bold mb-4">Ruta no encontrada</h1>
      <p class="text-text-mid">La ruta que buscas no existe o ha sido eliminada.</p>
      <a href="/ciudades" class="inline-block mt-6 text-transit-accent hover:underline">← Ver ciudades</a>
    </section>
  ) : (
    <>
      <section class="max-w-6xl mx-auto px-6 py-12">
        <a href={route.operator_slug ? `/ciudades/${route.operator_slug}` : '/ciudades'}
           class="text-text-lo text-sm hover:text-text-hi transition-colors">
          ← {route.operator_name || 'Ciudades'}
        </a>

        <div class="mt-6 flex flex-col md:flex-row gap-8">
          <div class="flex-1">
            <div class="flex items-center gap-4">
              <span
                class="inline-flex items-center justify-center w-16 h-16 rounded-2xl font-mono font-bold text-lg"
                style={{ backgroundColor: route.color || '#5A4A9A', color: '#FFFFFF' }}
              >
                {route.code}
              </span>
              <div>
                <h1 class="text-3xl font-bold">{route.name}</h1>
                <p class="text-text-lo text-sm">
                  {route.source === 'official' ? 'Ruta oficial' : 'Ruta comunitaria'}
                  {route.operator_name && ` · ${route.operator_name}`}
                </p>
              </div>
            </div>
            {route.description && (
              <p class="text-text-mid mt-6 leading-relaxed">{route.description}</p>
            )}
          </div>

          {mapUrl && (
            <div class="flex-1 min-h-48">
              <img
                src={mapUrl}
                alt={`Mapa de línea ${route.code}`}
                class="w-full rounded-2xl border border-transit-border object-cover h-64"
                loading="lazy"
              />
            </div>
          )}
        </div>
      </section>

      <section class="max-w-6xl mx-auto px-6 pb-10">
        <h2 class="text-xl font-semibold mb-6">Paradas ({stops.length})</h2>
        {stops.length === 0 ? (
          <p class="text-text-lo">No hay paradas registradas.</p>
        ) : (
          <div class="space-y-2">
            {stops.map((stop, i) => (
              <div class="flex items-center gap-4 p-4 rounded-xl bg-transit-surface border border-transit-border">
                <span class="text-text-disabled font-mono text-xs w-6 text-right">{stop.sequence}</span>
                <div class="w-3 h-3 rounded-full flex-shrink-0" style={{ backgroundColor: route.color || '#5A4A9A' }} />
                <div class="flex-1">
                  <p class="text-sm font-medium">{stop.name}</p>
                  {stop.direction && <p class="text-text-lo text-xs">{stop.direction}</p>}
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      {schedules.length > 0 && (
        <section class="max-w-6xl mx-auto px-6 pb-20">
          <h2 class="text-xl font-semibold mb-6">Horarios de hoy</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left border-collapse">
              <thead>
                <tr class="border-b border-transit-border text-text-lo text-xs uppercase tracking-wider">
                  <th class="py-3 px-4 font-medium">Salida</th>
                  <th class="py-3 px-4 font-medium">Parada</th>
                  <th class="py-3 px-4 font-medium">Días</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-transit-divider">
                {schedules.map((sched) => {
                  const stopName = stops.find(s => s.id === sched.stop_id)?.name || sched.stop_id;
                  return (
                    <tr class="hover:bg-transit-surface/50 transition-colors">
                      <td class="py-3 px-4 font-mono text-transit-neon-cyan">{sched.departure_time?.slice(0, 5)}</td>
                      <td class="py-3 px-4 text-text-mid">{stopName}</td>
                      <td class="py-3 px-4 text-text-lo text-xs">{sched.days}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      )}
    </>
  )}
</Layout>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BusTrip",
    "name": "Línea {route?.code || slug} — {route?.name || ''}",
    "provider": {
      "@type": "Organization",
      "name": "{route?.operator_name || 'Transitly'}"
    }
  }
</script>
