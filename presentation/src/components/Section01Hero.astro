---
import metrics from '../data/metrics.json';
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-transit-accent/5 via-transparent to-transit-bg-root pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/4 w-[600px] h-[600px] rounded-full bg-transit-accent/5 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] rounded-full bg-transit-state-info/3 blur-[100px] pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 w-full">
    <div class="max-w-3xl animate-fade-in">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-transit-accent-bg border border-transit-accent/20 text-transit-accent text-sm font-medium mb-8 animate-slide-down">
        <span class="inline-block w-2 h-2 rounded-full bg-transit-state-success animate-glow-pulse"></span>
        TFG · Trabajo Fin de Grado · DAM
      </div>

      <h1 class="text-6xl md:text-8xl font-bold mb-4 tracking-tight">
        <span class="text-gradient">Transitly</span>
      </h1>

      <p class="text-xl md:text-2xl text-transit-text-mid mb-6 max-w-2xl leading-relaxed">
        Aplicación multiplataforma de transporte público en tiempo real para ciudades medias españolas
      </p>

      <p class="text-base text-transit-text-lo mb-10 max-w-xl">
        Operador piloto: <span class="text-transit-text-hi font-semibold">{metrics.context.operator}</span> — {metrics.context.city}
      </p>

      <div class="flex flex-wrap gap-3 mb-12">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised">
          <span class="text-transit-accent font-semibold">{metrics.project.phasesCompleted}/{metrics.project.phases}</span> fases
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised">
          <span class="text-transit-state-success font-semibold">{metrics.tests.passed}</span> tests
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised">
          <span class="text-transit-state-info font-semibold">{metrics.project.features}</span> features
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised">
          <span class="text-transit-state-warning font-semibold">{metrics.project.edgeFunctions}</span> Edge Functions
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised">
          <span class="text-transit-accent font-semibold">{metrics.i18n.locales.length}</span> idiomas (ES/EN/AR)
        </span>
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised">
          Scorecard <span class="text-transit-state-success font-semibold">{metrics.scorecard.tfg}</span>
        </span>
      </div>

      <div class="flex flex-wrap gap-4">
        <a
          href="https://github.com/astralk9999/Transitly/releases/download/v1.0.0-tfg/app-release.apk"
          class="inline-flex items-center gap-2 px-8 py-4 bg-transit-accent text-white rounded-full font-semibold hover:bg-transit-accent/85 transition-all duration-200 accent-glow"
          download
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Descargar APK · {metrics.release.apkSize}
        </a>
        <a
          href="https://github.com/astralk9999/Transitly"
          class="inline-flex items-center gap-2 px-8 py-4 border border-transit-accent/30 text-transit-text-hi rounded-full font-semibold hover:bg-transit-accent-bg hover:border-transit-accent/50 transition-all duration-200"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          Ver en GitHub
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-slide-up animation-delay-700">
    <a href="#problema" class="flex flex-col items-center gap-2 text-transit-text-lo hover:text-transit-text-hi transition-colors text-xs">
      <span class="tracking-widest uppercase">Explorar</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><polyline points="6 9 12 15 18 9"/></svg>
    </a>
  </div>
</section>
