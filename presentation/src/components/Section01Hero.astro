---
import metrics from '../data/metrics.json';
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-transit-accent/5 via-transparent to-transit-bg-root pointer-events-none"></div>

  <!-- Animated background blobs -->
  <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] rounded-full bg-transit-accent/8 blur-[120px] pointer-events-none animate-float-slow"></div>
  <div class="absolute top-1/3 right-1/4 w-[350px] h-[350px] rounded-full bg-transit-accent/8 blur-[100px] pointer-events-none animate-float-medium"></div>
  <div class="absolute bottom-1/4 left-1/3 w-[400px] h-[400px] rounded-full bg-transit-state-info/5 blur-[110px] pointer-events-none animate-float-fast"></div>
  <div class="absolute bottom-1/3 right-1/3 w-[250px] h-[250px] rounded-full bg-transit-accent/6 blur-[80px] pointer-events-none animate-float-medium" style="animation-delay: 2s;"></div>

  <!-- Animated ring behind logo -->
  <div class="absolute top-1/2 right-[15%] lg:right-[8%] w-[350px] h-[350px] -translate-y-1/2 pointer-events-none">
    <div class="absolute inset-0 rounded-full border border-transit-accent/10 animate-spin-slow"></div>
    <div class="absolute inset-4 rounded-full border border-transit-accent/5 animate-spin-slow" style="animation-direction: reverse; animation-duration: 20s;"></div>
    <div class="absolute inset-8 rounded-full border border-transit-state-info/8 animate-spin-slow" style="animation-duration: 25s;"></div>
  </div>

  <!-- Floating particles -->
  <div class="absolute top-[20%] right-[30%] w-1.5 h-1.5 rounded-full bg-transit-accent/40 pointer-events-none animate-particle-1"></div>
  <div class="absolute top-[45%] right-[18%] w-2 h-2 rounded-full bg-transit-state-info/30 pointer-events-none animate-particle-2"></div>
  <div class="absolute bottom-[30%] right-[25%] w-1 h-1 rounded-full bg-transit-accent/50 pointer-events-none animate-particle-3"></div>
  <div class="absolute top-[55%] right-[12%] w-1.5 h-1.5 rounded-full bg-transit-accent/30 pointer-events-none animate-particle-4"></div>
  <div class="absolute top-[35%] right-[22%] w-1 h-1 rounded-full bg-transit-state-success/30 pointer-events-none animate-particle-5"></div>

  <!-- Animated grid dots behind text -->
  <div class="absolute hidden lg:block top-1/4 left-[8%] opacity-[0.03] pointer-events-none">
    <div class="grid grid-cols-8 gap-6">
      {Array.from({length: 64}).map(() => (
        <div class="w-1 h-1 rounded-full bg-transit-text-hi"></div>
      ))}
    </div>
  </div>

  <div class="relative max-w-6xl mx-auto px-6 py-20 w-full">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
      <div class="flex-1 relative">
        <div class="absolute -inset-8 bg-gradient-to-br from-transit-accent/5 via-transparent to-transparent rounded-3xl blur-2xl pointer-events-none"></div>
        <div class="relative">
          <div class="reveal inline-flex items-center gap-2 px-4 py-2 rounded-full bg-transit-accent-bg border border-transit-accent/20 text-transit-accent text-sm font-medium mb-8" data-delay="0">
            <span class="inline-block w-2 h-2 rounded-full bg-transit-state-success animate-glow-pulse"></span>
            TFG · Trabajo Fin de Grado · DAM
          </div>

          <h1 class="reveal text-6xl md:text-8xl font-bold mb-6 tracking-tight" data-delay="100">
            <span class="text-gradient">Transitly</span>
          </h1>

          <div class="reveal mb-10" data-delay="200">
            <p class="text-xl md:text-2xl text-transit-text-hi font-medium mb-3 max-w-2xl leading-snug">
              Transporte público en tiempo real
            </p>
            <p class="text-base text-transit-text-mid max-w-xl leading-relaxed">
              Aplicación multiplataforma para ciudades medias españolas. Diseñada para que cualquier compañía de autobuses pueda registrar sus rutas, paradas y horarios en una plataforma unificada.
            </p>
          </div>

          <div class="reveal flex flex-wrap gap-2 mb-10" data-delay="300">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised hover:border-transit-accent/30 transition-colors">
              <span class="text-transit-accent font-bold">28/28</span> fases
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised hover:border-transit-state-success/30 transition-colors">
              <span class="text-transit-state-success font-bold">619</span> tests
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised hover:border-transit-state-info/30 transition-colors">
              <span class="text-transit-state-info font-bold">27</span> features
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised hover:border-transit-state-warning/30 transition-colors">
              <span class="text-transit-state-warning font-bold">4</span> Edge Functions
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-transit-bg-raised/80 rounded-full text-xs font-mono text-transit-text-hi border border-transit-bg-raised hover:border-transit-accent/30 transition-colors">
              <span class="text-transit-accent font-bold">3</span> idiomas
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-transit-bg-raised/80 rounded-full text-xs font-mono border border-transit-bg-raised hover:border-transit-state-success/30 transition-colors">
              <span class="text-transit-state-success font-bold">619</span> <span class="text-transit-text-hi">tests · 0 fallos</span>
            </span>
          </div>

          <div class="reveal flex flex-wrap gap-4" data-delay="400">
            <a
              href="https://github.com/astralk9999/Transitly/releases/latest"
              data-download-apk
              class="inline-flex items-center gap-2.5 px-8 py-4 bg-transit-accent text-white rounded-full font-semibold text-sm hover:bg-transit-accent/90 transition-all duration-200 accent-glow hover:scale-105"
              target="_blank"
              rel="noopener"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              Descargar APK · {metrics.release.apkSize}
            </a>
            <a
              href="https://github.com/astralk9999/Transitly"
              class="inline-flex items-center gap-2.5 px-8 py-4 border border-transit-text-mid/30 text-transit-text-hi rounded-full font-semibold text-sm hover:bg-transit-accent-bg hover:border-transit-accent/50 transition-all duration-200 hover:scale-105"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              Ver en GitHub
            </a>
          </div>
        </div>
      </div>

      <div class="reveal-scale lg:w-[350px] shrink-0 flex justify-center" data-delay="400">
        <img
          src={`${import.meta.env.BASE_URL}/logoblanco.png`}
          alt="Transitly"
          class="w-full max-w-[280px] h-auto drop-shadow-[0_0_60px_rgba(151,125,223,0.3)]"
          width="500"
          height="500"
        />
      </div>
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-slide-up animation-delay-700">
    <a href="#problema" class="flex flex-col items-center gap-2 text-transit-text-lo hover:text-transit-text-hi transition-colors text-xs">
      <span class="tracking-widest uppercase">Explorar</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><polyline points="6 9 12 15 18 9"/></svg>
    </a>
  </div>
</section>
