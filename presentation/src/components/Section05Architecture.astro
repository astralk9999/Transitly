---
import metrics from '../data/metrics.json';
---

<section id="arquitectura" class="py-24 px-6 max-w-6xl mx-auto">
  <h2 class="text-4xl font-bold mb-4">Arquitectura</h2>
  <p class="text-transit-text-mid mb-12 text-lg max-w-3xl">
    Feature-first con capas bien definidas: UI → Estado → Datos → Caché → Backend. {metrics.code.features} features organizadas por dominio funcional.
  </p>

  <div class="bg-transit-bg-surface p-8 rounded-2xl border border-transit-bg-raised mb-12 overflow-x-auto">
    <pre class="text-transit-text-mid font-mono text-sm leading-relaxed whitespace-pre">
      graph TB
        UI["Features 27<br/>Flutter UI"]
        State["Riverpod 2.6<br/>State Management"]
        Data["Data Layer<br/>12 Repos SWR + 4 sin SWR"]
        Cache["Hive 2.2<br/>17 boxes + 2 cifradas"]
        Backend["Supabase<br/>PostgreSQL + RLS"]
        Edge["4 Edge Functions<br/>Deno"]
        UI --> State
        State --> Data
        Data --> Cache
        Data --> Backend
        Backend --> Edge
    </pre>
  </div>

  <h3 class="text-2xl font-bold mb-6">Stack tecnológico</h3>
  <div class="flex flex-wrap gap-3">
    {["Flutter 3.x", "Dart 3", "Riverpod 2.6", "Supabase", "Firebase", "Sentry", "PostHog", "Hive", "GoRouter", "Freezed"].map((tech) => (
      <span class="px-4 py-2 bg-transit-accent-bg text-transit-accent rounded-full text-sm font-medium border border-transit-accent/20">{tech}</span>
    ))}
  </div>
</section>
