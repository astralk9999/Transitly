---
import metrics from '../data/metrics.json';
---

<section id="metricas" class="py-28 px-6 max-w-6xl mx-auto">
  <div class="reveal">
    <div class="section-divider mb-6"></div>
    <h2 class="text-4xl md:text-5xl font-bold mb-4">Métricas Verificadas</h2>
    <p class="text-transit-text-mid text-lg max-w-3xl leading-relaxed">
      Todas las cifras están verificadas contra el código fuente actual. Regeneradas, no copiadas de documentación anterior.
    </p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-14">

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-accent/40 transition-all duration-300" data-delay="100">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-accent mb-2" data-counter data-counter-target={metrics.project.phasesCompleted} data-counter-suffix={`/${metrics.project.phases}`}>{metrics.project.phasesCompleted}/{metrics.project.phases}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">fases completadas</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-success/40 transition-all duration-300" data-delay="150">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-success mb-2" data-counter data-counter-target={metrics.tests.passed}>{metrics.tests.passed}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">tests verdes</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">+{metrics.tests.skipped} skipped</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-info/40 transition-all duration-300" data-delay="250">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-info mb-2">0</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">flutter analyze</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">issues</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-accent/40 transition-all duration-300" data-delay="300">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-accent mb-2">{metrics.release.apkSize}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">APK release</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">compila OK</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-info/40 transition-all duration-300" data-delay="350">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-info mb-2">{metrics.ci.jobs}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">CI jobs</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">{metrics.ci.jobsList.join(' + ')}</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-success/40 transition-all duration-300" data-delay="400">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-success mb-2">{metrics.project.features}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">features</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-accent/40 transition-all duration-300" data-delay="450">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-accent mb-2">{metrics.project.repositoriesCanonical}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">repos canónicos</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-info/40 transition-all duration-300" data-delay="500">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-info mb-2">{metrics.project.migrations}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">migraciones SQL</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-warning/40 transition-all duration-300" data-delay="550">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-warning mb-2">{metrics.project.edgeFunctions}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">Edge Functions</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-success/40 transition-all duration-300" data-delay="600">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-success mb-2">{metrics.scorecard.wcagLevel}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">WCAG 2.2</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">verificado estáticamente</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-accent/40 transition-all duration-300" data-delay="650">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-accent mb-2">{metrics.i18n.locales.length}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">idiomas</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">{metrics.i18n.keys.es}/{metrics.i18n.keys.en}/{metrics.i18n.keys.ar} claves</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-cancelled/40 transition-all duration-300" data-delay="700">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-cancelled mb-2">{metrics.project.realtimeRepos}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">F13 Realtime</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">repos con canal</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-info/40 transition-all duration-300" data-delay="750">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-info mb-2">{metrics.project.paginationRepos}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">paginación</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">repos de lista</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-state-success/40 transition-all duration-300" data-delay="800">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-state-success mb-2">{metrics.project.autoDisposeProviders}</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">autoDispose</div>
      <div class="text-[10px] text-transit-text-lo mt-1 font-mono">providers críticos</div>
    </div>

    <div class="glass-card hover-lift p-6 reveal text-center animate-scale-in group hover:border-transit-accent/40 transition-all duration-300" data-delay="850">
      <div class="text-4xl md:text-5xl font-bold font-mono text-transit-accent mb-2">{metrics.project.freezedModels}+</div>
      <div class="text-xs text-transit-text-lo uppercase tracking-wider">modelos @freezed</div>
    </div>

  </div>
</section>
