---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { TFG_DOCS, metaForId, orderForId } from '../../data/tfgDocs';

const docs = await getCollection('tfg');
const sorted = docs.sort((a, b) => orderForId(a.id) - orderForId(b.id));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsBase = `${base}/docs`;
const defensaUrl = `${base}/defensa`;
// id real (del content layer) para cada número de documento
const idByNum: Record<string, string> = {};
for (const d of sorted) {
  const m = metaForId(d.id);
  if (m) idByNum[m.num] = d.id;
}
const linkFor = (num: string) => idByNum[num] ? `${docsBase}/${idByNum[num]}` : docsBase;

const repoUrl = 'https://github.com/astralk9999/Transitly';
const releaseUrl = 'https://github.com/astralk9999/Transitly/releases/latest';

// Estructura del proyecto (guía del TFG)
const fases = [
  { n: '1', t: 'Análisis del contexto y detección de necesidades', p: 'Sector, necesidades, oportunidades y guión inicial.', doc: '01' },
  { n: '2', t: 'Diseño del proyecto', p: 'Objetivos, fases, viabilidad técnica, recursos, calidad y requisitos legales.', doc: '02' },
  { n: '3', t: 'Planificación de la ejecución', p: 'Secuenciación, plazos, recursos, riesgos y entregables.', doc: '03' },
  { n: '4', t: 'Desarrollo e implementación', p: 'Programación, BBDD, interfaces, servicios, pruebas y documentación de código.', doc: '04' },
  { n: '5', t: 'Seguimiento, evaluación y documentación', p: 'Control, incidencias, feedback, manuales y evaluación.', doc: '05' },
];

// "Documentos que deben entregar" (mapeados a su ubicación real)
const entregables = [
  { doc: 'Memoria del Proyecto', desc: 'Documento principal que recopila todas las fases.', links: [['Docs 01–05', linkFor('01')]] },
  { doc: 'Aplicación Final', desc: 'Código fuente y ejecutable de la app multiplataforma.', links: [['Código (GitHub)', repoUrl], ['APK (release)', releaseUrl]] },
  { doc: 'Documentación Técnica', desc: 'Manual de instalación, configuración y mantenimiento.', links: [['Doc 06 — Manual técnico', linkFor('06')]] },
  { doc: 'Manual de Usuario', desc: 'Instrucciones claras para un usuario final no técnico.', links: [['Doc 07 — Manual de usuario', linkFor('07')]] },
  { doc: 'Presentación Final', desc: 'Diapositivas para la defensa del proyecto.', links: [['Deck de defensa', defensaUrl], ['Doc 08 — Guion', linkFor('08')]] },
  { doc: 'Diagrama de Gantt y cronograma', desc: 'Planificación temporal del desarrollo.', links: [['Doc 03 §2 — Gantt', linkFor('03')]] },
  { doc: 'Evaluación del Proyecto', desc: 'Indicadores, incidencias, mejoras y resultados obtenidos.', links: [['Doc 05 — Evaluación', linkFor('05')]] },
];
---

<Layout title="Entregables del TFG — Transitly" description="Memoria, manuales, presentación y evaluación del TFG Transitly: todos los documentos del proyecto.">
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="section-divider mb-6"></div>
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Entregables del TFG</h1>
    <p class="text-transit-text-mid text-lg max-w-3xl leading-relaxed">
      Memoria, manuales, planificación, evaluación y presentación del proyecto <strong class="text-transit-text-hi">Transitly</strong>.
      Toda la documentación es consultable online y se genera a partir de los documentos versionados en el repositorio.
    </p>

    <!-- Objetivo general -->
    <div class="glass-card-raised p-6 md:p-8 mt-10">
      <h2 class="text-sm font-mono uppercase tracking-wider text-transit-accent mb-3">Objetivo general</h2>
      <p class="text-transit-text-mid leading-relaxed">
        Diseñar, planificar, ejecutar, documentar y evaluar una aplicación multiplataforma funcional que responda a una
        necesidad real del entorno productivo —la información de transporte público en tiempo real en ciudades medias—,
        aplicando los conocimientos y competencias del ciclo de Desarrollo de Aplicaciones Multiplataforma (DAM).
      </p>
    </div>

    <!-- Documentos que deben entregar -->
    <h2 class="text-2xl font-bold mt-16 mb-2">Documentos que deben entregar</h2>
    <p class="text-transit-text-mid mb-6">Cada entregable exigido por la guía del TFG, con su ubicación.</p>
    <div class="glass-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-transit-accent/10">
          <tr>
            <th class="text-left p-4 font-semibold text-transit-text-hi">Documento</th>
            <th class="text-left p-4 font-semibold text-transit-text-hi hidden md:table-cell">Descripción</th>
            <th class="text-left p-4 font-semibold text-transit-text-hi">Acceso</th>
          </tr>
        </thead>
        <tbody>
          {entregables.map((e) => (
            <tr class="border-t border-transit-bg-raised/60">
              <td class="p-4 font-semibold text-transit-text-hi align-top">{e.doc}</td>
              <td class="p-4 text-transit-text-mid align-top hidden md:table-cell">{e.desc}</td>
              <td class="p-4 align-top">
                <div class="flex flex-wrap gap-2">
                  {e.links.map(([label, href]) => (
                    <a href={href} class="inline-block px-3 py-1.5 rounded-full bg-transit-accent/10 text-transit-accent text-xs font-medium hover:bg-transit-accent/20 transition-colors">{label} →</a>
                  ))}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Memoria por documentos -->
    <h2 class="text-2xl font-bold mt-16 mb-2">Memoria del proyecto</h2>
    <p class="text-transit-text-mid mb-6">Los ocho documentos que componen la memoria, en orden. Pulsa para leerlos online.</p>
    <div class="grid md:grid-cols-2 gap-4">
      {TFG_DOCS.map((d) => (
        <a href={linkFor(d.num)} class="glass-card hover-lift p-5 group flex gap-4">
          <span class="text-2xl font-mono font-bold text-transit-accent shrink-0">{d.num}</span>
          <div class="min-w-0">
            <div class="font-semibold text-transit-text-hi group-hover:text-transit-accent transition-colors">{d.title}</div>
            <div class="text-sm text-transit-text-mid mt-1 leading-relaxed">{d.desc}</div>
          </div>
        </a>
      ))}
    </div>

    <!-- Estructura del proyecto -->
    <h2 class="text-2xl font-bold mt-16 mb-2">Estructura del proyecto</h2>
    <p class="text-transit-text-mid mb-6">Las cinco fases metodológicas del TFG y el documento donde se desarrolla cada una.</p>
    <div class="space-y-3">
      {fases.map((f) => (
        <a href={linkFor(f.doc)} class="glass-card hover-lift p-5 flex items-center gap-5 group">
          <span class="w-10 h-10 rounded-full bg-transit-accent/10 grid place-items-center font-mono font-bold text-transit-accent shrink-0">{f.n}</span>
          <div class="min-w-0 flex-1">
            <div class="font-semibold text-transit-text-hi group-hover:text-transit-accent transition-colors">{f.t}</div>
            <div class="text-sm text-transit-text-mid mt-0.5">{f.p}</div>
          </div>
          <span class="text-transit-text-lo group-hover:text-transit-accent transition-colors shrink-0">→</span>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="glass-card-raised p-6 md:p-8 mt-16 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-bold text-transit-text-hi">¿Listo para verlo en acción?</h3>
        <p class="text-transit-text-mid text-sm mt-1">Descarga la app o repasa la presentación de defensa.</p>
      </div>
      <div class="flex gap-3 shrink-0">
        <a href={defensaUrl} class="px-5 py-2.5 rounded-full border border-transit-accent/30 text-transit-text-hi text-sm font-semibold hover:bg-transit-accent-bg transition-all">Ver defensa</a>
        <a href={releaseUrl} data-download-apk class="px-5 py-2.5 rounded-full bg-transit-accent text-white text-sm font-semibold hover:bg-transit-accent/85 transition-all" target="_blank" rel="noopener">Descargar APK</a>
      </div>
    </div>
  </section>
</Layout>
